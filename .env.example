# ==========================================
# Environment Variables for Vercel Deployment
# (Add these in Vercel Project Settings > Environment Variables)
# ==========================================

# MongoDB Atlas Connection String
# e.g., mongodb+srv://<username>:<password>@cluster0.xxx.mongodb.net/interview_ai?retryWrites=true&w=majority
MONGODB_URI=

# JWT Secret (any random 32+ character string)
JWT_SECRET=

# Google Gemini API Key (from https://aistudio.google.com/)
GEMINI_API_KEY=

# Murf AI API Key (from https://murf.ai/)
MURF_API_KEY=

# AssemblyAI API Key (from https://www.assemblyai.com/)
ASSEMBLYAI_API_KEY=

# Environment Mode
NODE_ENV=production
