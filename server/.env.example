# Server Port (assigned by hosting provider automatically or defaults to 5000)
PORT=5000

# Environment Mode
NODE_ENV=production

# MongoDB Atlas Connection String
# e.g., mongodb+srv://<username>:<password>@cluster0.xxx.mongodb.net/interview_ai?retryWrites=true&w=majority
MONGODB_URI=

# JWT Secret Key for authenticating users (generate a random 32+ character string)
JWT_SECRET=

# Google Gemini API Key (from https://aistudio.google.com/)
GEMINI_API_KEY=

# Murf AI API Key (from https://murf.ai/)
MURF_API_KEY=

# AssemblyAI API Key (from https://www.assemblyai.com/)
ASSEMBLYAI_API_KEY=

# Frontend Client URL for CORS (comma-separated if multiple, e.g. https://your-site.vercel.app)
CLIENT_URL=http://localhost:5173
